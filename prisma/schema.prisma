// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
  moduleFormat = "cjs"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

/* ---------------------------------------------------------
   ENUMS
--------------------------------------------------------- */

enum Role {
  ADMIN
  OPERATOR
  GUEST
}

enum SensorType {
  CO2
  TEMPERATURE
  HUMIDITY
  WIND_INDOOR
  WIND_OUTDOOR
  TILT_STRUCTURAL
  LIGHT_DENSITY  
  TARMAC_TEMP
  CAMERA_AI_CROWD
}

enum SensorStatus {
  ACTIVE
  WARNING      
  CRITICAL     
  MAINTENANCE  
  CALIBRATING  
  OFFLINE      
  UNREACHABLE  
}

enum ZoneType {
  TERMINAL_DOMESTIC
  TERMINAL_INTERNATIONAL
  CHECK_IN
  SECURITY_GATE
  WAITING_LOUNGE
  BAGGAGE_CLAIM
  RUNWAY
  TAXIWAY
  APRON         
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  APPROACHING
  LANDED
  TAXIING
  PARKED        
  BOARDING
  PUSHBACK
  DEPARTED
  DIVERTED
  CANCELLED
}

enum FlightDirection {
  INBOUND
  OUTBOUND
  TURNAROUND
}

enum VehicleType {
  BAGGAGE_TUG
  FUEL_TRUCK
  PASSENGER_BUS
  CATERING_TRUCK
  FOLLOW_ME_CAR
}

enum VehicleStatus {
  IDLE
  DISPATCHED
  CHARGING
  MAINTENANCE
  OFFLINE
}

/* ---------------------------------------------------------
   1. CORE: AIRPORTS, ZONES & INFRASTRUCTURE
--------------------------------------------------------- */

/// Root tenant model for strict data isolation
model Airport {
  id        String   @id @default(uuid())
  code      String   @unique /// e.g., "VVTS", "VVLT"
  name      String
  latitude  Float
  longitude Float

  zones     Zone[]
  sensors   Sensor[]
  flights   Flight[]

  groundVehicles  GroundVehicle[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("airports")
}

model Zone {
  id              String         @id @default(uuid())
  name            String
  type            ZoneType
  floorLevel      Int            @default(1)
  maxCapacity     Int?           

  // Multi-tenancy isolation
  airportId       String
  airport         Airport        @relation(fields: [airportId], references: [id], onDelete: Cascade)

  // ArcGIS Integration
  gisItemId       String?  
  gisSceneUrl     String?  

  currentDensity  Int            @default(0) 
  
  sensors         Sensor[]
  parkingStands   ParkingStand[] 
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([airportId])
  @@map("zones")
}

model ParkingStand {
  id          String   @id @default(uuid())
  code        String   
  
  x           Float
  y           Float
  z           Float
  
  isOccupied  Boolean  @default(false)
  
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  flights     Flight[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, zoneId]) /// Ensure gates are unique per zone/airport
  @@map("parking_stands")
}

model BuildingLayer {
  id            String   @id @default(uuid())
  name          String
  arcgisItemId  String   @unique
  url           String
  isVisible     Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("building_layers")
}

/* ---------------------------------------------------------
   2. IOT HARDWARE & DATA
--------------------------------------------------------- */

model Sensor {
  id            String       @id @default(uuid())
  name          String
  type          SensorType
  status        SensorStatus @default(ACTIVE)
  
  x             Float
  y             Float
  z             Float
  
  currentValue  Float?       
  lastReadAt    DateTime?    

  // Multi-tenancy isolation
  airportId     String
  airport       Airport      @relation(fields: [airportId], references: [id], onDelete: Cascade)

  zoneId        String
  zone          Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  logs          SensorLog[]
  
  gisFeatureId  String?  

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  imageUrl      String?

  @@index([airportId, type, status]) /// Optimized for specific airport dashboard queries
  @@map("sensors")
}

model SensorLog {
  id          String   @id @default(uuid())
  sensorId    String
  sensor      Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  
  value       Float
  timestamp   DateTime @default(now())
  
  @@index([sensorId, timestamp(sort: Desc)]) 
  @@map("sensor_logs")
}

/* ---------------------------------------------------------
   3. AVIATION TRACKING
--------------------------------------------------------- */

model Flight {
  id              String          @id @default(uuid())
  flightNumber    String          @unique 
  airline         String
  origin          String
  destination     String
  status          FlightStatus    @default(SCHEDULED)
  
  assignedRunway  String?        
  
  // Multi-tenancy isolation
  airportId       String
  airport         Airport         @relation(fields: [airportId], references: [id], onDelete: Cascade)

  parkingStandId  String?      
  parkingStand    ParkingStand?   @relation(fields: [parkingStandId], references: [id])
  
  telemetry       FlightTelemetry[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  imageUrl        String?
  logoUrl         String?

  direction       FlightDirection @default(TURNAROUND)

  @@index([airportId, status])
  @@map("flights")
}

model FlightTelemetry {
  id          String   @id @default(uuid())
  flightId    String
  flight      Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  
  longitude   Float
  latitude    Float
  altitude    Float
  heading     Float
  speed       Float

  timestamp   DateTime @default(now())

  @@index([flightId, timestamp(sort: Desc)])
  @@map("flight_telemetry")
}

/* ---------------------------------------------------------
   4. SYSTEM & AUTH
--------------------------------------------------------- */

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  role      Role      @default(OPERATOR)
  
  sessions  Session[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  
  createdAt    DateTime @default(now())

  @@map("sessions")
}


/* ---------------------------------------------------------
   5. Ground Vehicle
--------------------------------------------------------- */
model GroundVehicle {
  id              String          @id @default(uuid())
  callsign        String          @unique /// e.g., "TUG-04", "FUEL-12"
  type            VehicleType
  status          VehicleStatus   @default(IDLE)
  
  // Multi-tenancy isolation
  airportId       String
  airport         Airport         @relation(fields: [airportId], references: [id], onDelete: Cascade)

  telemetry       VehicleTelemetry[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([airportId, type, status])
  @@map("ground_vehicles")
}

model VehicleTelemetry {
  id              String          @id @default(uuid())
  vehicleId       String
  vehicle         GroundVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  longitude       Float
  latitude        Float
  speed           Float
  batteryLevel    Float?          /// Useful for EV GSE fleets

  timestamp       DateTime        @default(now())

  @@index([vehicleId, timestamp(sort: Desc)])
  @@map("vehicle_telemetry")
}