# Server Configuration
NODE_ENV=development
PORT=3000

# Database Connection (Development)
# Replace <USER>, <PASSWORD>, and <DB_NAME> with your local Postgres credentials
DATABASE_URL="postgresql://<USER>:<PASSWORD>@localhost:5432/<DB_NAME>?schema=public"

# CORS Configuration (Next.js Frontend)
CLIENT_URL="http://localhost:3000"

# Local Docker Redis: `docker compose up -d` (exposed on 6380)
# Production (Upstash): REDIS_URL="rediss://default:<TOKEN>@<HOST>.upstash.io:6379"
REDIS_URL="redis://localhost:6380"

# Only set to true when running more than one API instance (every socket emit becomes a Redis PUBLISH)
SOCKET_REDIS_ADAPTER=false

# How often (seconds) the live sensor snapshot is persisted to Redis; memory is updated every tick
LIVE_SENSOR_CACHE_FLUSH_SECONDS=300

# Sensor history retention: raw 1-minute samples (min 2) and hourly min/max/avg rollups
SENSOR_RAW_RETENTION_HOURS=48
SENSOR_ROLLUP_RETENTION_DAYS=400
